NEXT_PUBLIC_API_URL=http://localhost:[BACKEND_PORT]

# Clerk Authentication - get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

NEXT_PUBLIC_MERCURE_URL=https://mercure.madainsight.com/.well-known/mercure
MERCURE_JWT_SECRET=REDACTED-MERCURE-JWT-SECRET

# Tracking - leave empty to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
