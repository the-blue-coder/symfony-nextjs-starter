# Force LF line endings and UTF-8 for all text files
* text=auto eol=lf

*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.sh        text eol=lf
*.php       text eol=lf
*.env       text eol=lf
*.css       text eol=lf
*.svg       text eol=lf
*.xml       text eol=lf
*.txt       text eol=lf

# Binary - never modify
*.ico       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.lock      text eol=lf
