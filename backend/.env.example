APP_ENV=prod
APP_SECRET=
APP_NAME=[project]
DEFAULT_URI=https://[project].domain.com

# Database
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://app:PASSWORD@postgres:5432/app?serverVersion=16&charset=utf8"

# Clerk Authentication - get values from https://dashboard.clerk.com
CLERK_JWKS_URI=https://your-clerk-domain/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_

# Frontend
FRONTEND_URL=https://[project].domain.com

# CORS
CORS_ALLOW_ORIGIN=

# AWS Region
AWS_DEFAULT_REGION=us-east-2

# AWS SES
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# Mailer
MAILER_DSN=ses+https://ACCESS_KEY:URL_ENCODED_SECRET@default?region=us-east-2
MAILER_FROM=contact@madainsight.com

# AWS S3 Backup
AWS_S3_BACKUP_ACCESS_KEY_ID=
AWS_S3_BACKUP_SECRET_ACCESS_KEY=
AWS_S3_BACKUP_BUCKET=
AWS_S3_BACKUP_KEEP_LAST=4
AWS_S3_BACKUP_WEBHOOK_SECRET=

# Mercure (external hub - https://mercure.madainsight.com)
MERCURE_URL=https://mercure.madainsight.com/.well-known/mercure
MERCURE_PUBLIC_URL=https://mercure.madainsight.com/.well-known/mercure
MERCURE_JWT_SECRET=

# Messenger (Redis)
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
